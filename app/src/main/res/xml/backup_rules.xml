<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- auth tokens must never leave the device via backups -->
    <exclude domain="file" path="datastore/auth.preferences_pb" />
    <!-- ledger data is server-backed; excluding avoids stale restores -->
    <exclude domain="database" path="teramera.db" />
    <exclude domain="database" path="teramera.db-wal" />
    <exclude domain="database" path="teramera.db-shm" />
</full-backup-content>
